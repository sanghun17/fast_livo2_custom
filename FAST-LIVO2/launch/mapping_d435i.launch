<launch>
<!-- Launch file for RealSense D435i with Fast-LIVO2 (Jetson Orin AGX) -->
<!-- Launch the camera separately FIRST. VERIFIED config (all 4 streams live   -->
<!-- through the onboard Realtek hub: depth/color 15Hz, IMU 202Hz, pc 15Hz):   -->
<!--   roslaunch realsense2_camera rs_camera.launch \                          -->
<!--     initial_reset:=true \             # wakes the IMU motion module        -->
<!--     depth_width:=640 depth_height:=480 depth_fps:=15 \                    -->
<!--     color_width:=640 color_height:=480 color_fps:=15 \                    -->
<!--     enable_gyro:=true enable_accel:=true \                                -->
<!--     unite_imu_method:=linear_interpolation \                              -->
<!--     filters:=pointcloud allow_no_texture_points:=true \                   -->
<!--     enable_sync:=false                # IMU clock else breaks pc syncer    -->

<!-- FAST-LIVO root frame: LIVMapper broadcasts odom -> camera_init ITSELF (no static
     publisher here, no enable flag). It is ALWAYS subscribed to mocap/gt_pose_topic and
     self-selects at runtime: the FIRST OptiTrack pose latches the transform to the
     testbed-centre origin (gt_odom_cbk); if mocap never publishes it falls back to the
     hardcoded optical-axis flip (camera_init optical Z/X/Y -> ROS X/Y/Z, zero translation).
     With mocap up, /aft_mapped_to_optitrack + /aft_mapped_to_body_imu_propagated START at the true mocap pose
     and then follow LIVO. (/aft_mapped_to_init stays in camera_init, 0,0,0 at boot, BY
     DESIGN — internal estimate.) Re-anchor: rostopic pub -1 /livo/reinit std_msgs/Empty {} -->
<param name="mocap/gt_pose_topic" value="/vrpn_client_node/pure/pose"/>

	<!-- Load Fast-LIVO2 main config for D435i -->
	<rosparam command="load" file="$(find fast_livo)/config/d435i.yaml" />

	<!-- Camera intrinsics come ONLINE from /camera/color/camera_info at startup
	     (see d435i.yaml common/online_intrinsics_en). This only NAMES the offline
	     fallback file; it is deliberately NOT rosparam-loaded here. LIVMapper loads it
	     itself, and ONLY if the camera_info topic is absent -> when online works, no
	     (stale) cam_* params ever appear on the param server. -->
	<param name="common/cam_calib_file" value="$(find fast_livo)/config/camera_d435i.yaml" />

	<!-- Per-frame VIO/LIO timing-table + feature-count console spam: true=on, false=quiet.
	     Read once at startup as rosparam debug/verbose; flip this and just re-run (NO rebuild). -->
	<param name="debug/verbose" value="false" />

	<!-- Fast-LIVO2 mapping node.
	     taskset CPUS_FASTLIVO (config/ros_env.sh — $(env) = HARD requirement, this
	     launch refuses to start without ros_env.sh sourced): EXCLUSIVE cores.
	     The LIO/VIO loop is single-threaded (ros::spinOnce in run()) and measured
	     ~0.5 core, so 2 dedicated cores cover it; the pool (4-11) and the camera
	     (0-1) are pinned OFF them, so voxblox/planner/JAX startup bursts can no
	     longer stall the loop ("IMU and LiDAR not synced" delta spikes) — and this
	     node's own nice'd startup burst can no longer preempt the camera's
	     libusb/uvc threads -> "uvc streamer watchdog" -> 10-25s depth/color outage
	     (verified live: watchdog fired 2s after an unfenced start, "not synced"
	     storm lasted exactly until the streams came back).
	     nice -n -15: kept as insurance against UNPINNED strays (debug shells,
	     rostopic) landing on these cores. (RT/chrt is blocked here: the container
	     cgroup has cpu.rt_runtime_us=0, so SCHED_FIFO -> EPERM.) -->
	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen"
	      launch-prefix="taskset -c $(env CPUS_FASTLIVO) nice -n -15" />

	<!-- Smart TF Bridge: aft_mapped -> camera_imu_optical_frame (re-rooted onto
	     RealSense's own camera TF tree) + aft_mapped -> base_link (plain alias,
	     no other publisher owns that name). One node manages every bridge in
	     this list — see smart_static_tf_bridge.py.
	     base_link is aliased here, not via MAVROS's local_position tf.send: that's
	     deliberately off (px4_config.yaml) so FAST-LIVO stays the single odom->body
	     TF authority; enabling it would add a second, independently-converging
	     odom->body tree. -->
	<node pkg="fast_livo" type="smart_static_tf_bridge.py" name="smart_tf_bridge" output="log">
		<rosparam param="bridges">
			- {parent: aft_mapped, child: camera_imu_optical_frame}
			- {parent: aft_mapped, child: base_link}
		</rosparam>
	</node>

	<!-- Divergence guard: if |pos| ever exceeds max_dist the estimate has already
	     diverged (and voxblox would allocate blocks along the runaway ray until
	     RAM dies) -> rosnode kill laserMapping, loud FATAL in the log.
	     Disable deliberately with enabled=false for large-motion tests. -->
	<node pkg="fast_livo" type="odom_guard.py" name="odom_guard" output="screen">
		<param name="max_dist" value="100.0" />
		<param name="kill_node" value="/laserMapping" />
		<param name="enabled" value="true" />
	</node>

</launch>
