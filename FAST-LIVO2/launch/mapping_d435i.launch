<launch>
<!-- Launch file for RealSense D435i with Fast-LIVO2 (Jetson Orin AGX) -->
<!-- Launch the camera separately FIRST. VERIFIED config (all 4 streams live   -->
<!-- through the onboard Realtek hub: depth/color 15Hz, IMU 202Hz, pc 15Hz):   -->
<!--   roslaunch realsense2_camera rs_camera.launch \                          -->
<!--     initial_reset:=true \             # wakes the IMU motion module        -->
<!--     depth_width:=640 depth_height:=480 depth_fps:=15 \                    -->
<!--     color_width:=640 color_height:=480 color_fps:=15 \                    -->
<!--     enable_gyro:=true enable_accel:=true \                                -->
<!--     unite_imu_method:=linear_interpolation \                              -->
<!--     filters:=pointcloud allow_no_texture_points:=true \                   -->
<!--     enable_sync:=false                # IMU clock else breaks pc syncer    -->

<node pkg="tf" type="static_transform_publisher" name="odom_to_camera_init"
      args="0 0 0 0.5 -0.5 0.5 -0.5 odom camera_init 100" />

	<!-- Load Fast-LIVO2 main config for D435i -->
	<rosparam command="load" file="$(find fast_livo)/config/d435i.yaml" />

	<!-- Fast-LIVO2 mapping node.
	     launch-prefix "nice -n -15": the LIO/VIO loop is single-threaded (ros::spinOnce
	     in run()), so a CPU burst from launching voxblox/planner can preempt it, stall
	     the loop, and cause "IMU and LiDAR not synced" delta spikes. High CFS priority
	     keeps it scheduled through those bursts. (RT/chrt is blocked here: the container
	     cgroup has cpu.rt_runtime_us=0, so SCHED_FIFO -> EPERM.) -->
	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="log"
	      launch-prefix="nice -n -15">
		<rosparam file="$(find fast_livo)/config/camera_d435i.yaml" />
	</node>

	<!-- Smart TF Bridge: Connects LIVO and RealSense TF trees -->
	<node pkg="fast_livo" type="smart_static_tf_bridge.py" name="smart_tf_bridge" output="log">
		<param name="parent" value="aft_mapped" />
		<param name="child" value="camera_imu_optical_frame" />
		<param name="x" value="0.0" />
		<param name="y" value="0.0" />
		<param name="z" value="0.0" />
		<param name="qx" value="0.0" />
		<param name="qy" value="0.0" />
		<param name="qz" value="0.0" />
		<param name="qw" value="1.0" />
	</node>

</launch>
